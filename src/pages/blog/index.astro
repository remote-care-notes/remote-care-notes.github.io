---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { CHAPTERS as chapters } from '../../chapters';

const posts = await getCollection('blog');
const slugSet = new Set(posts.map((p) => p.id));
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin-bottom: 2em;
			}
			.toc {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc-item {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 0.9em 0;
				display: flex;
				gap: 0.6em;
			}
			.toc-num {
				flex-shrink: 0;
				min-width: 2em;
				color: rgb(var(--gray));
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.toc-body {
				flex: 1;
			}
			.toc-title {
				font-weight: 700;
			}
			.toc-title a {
				text-decoration: none;
			}
			.toc-title a:hover {
				text-decoration: underline;
			}
			.toc-desc {
				margin: 0.2em 0 0 0;
				color: rgb(var(--gray));
				font-size: 0.92em;
			}
			.toc-soon .toc-num,
			.toc-soon .toc-title,
			.toc-soon .toc-desc {
				color: rgb(var(--gray));
			}
			.toc-soon .toc-title::after {
				content: '（準備中）';
				font-weight: 400;
				font-size: 0.85em;
				margin-left: 0.4em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>記事一覧</h1>
			<div class="intro">
				<p>1番から順に読むと全体の流れがつかめます。気になる章だけのつまみ食いもどうぞ。</p>
			</div>
			<ol class="toc">
				{
					chapters.map((c) => {
						const exists = slugSet.has(c.slug);
						return (
							<li class={`toc-item ${exists ? '' : 'toc-soon'}`}>
								<span class="toc-num">{c.num}.</span>
								<div class="toc-body">
									<div class="toc-title">
										{exists ? (
											<a href={`/blog/${c.slug}/`}>{c.title}</a>
										) : (
											<span>{c.title}</span>
										)}
									</div>
									<p class="toc-desc">{c.desc}</p>
								</div>
							</li>
						);
					})
				}
			</ol>
		</main>
		<Footer />
	</body>
</html>
