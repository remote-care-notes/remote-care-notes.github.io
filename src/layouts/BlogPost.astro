---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & { id?: string; headings?: Heading[] };

const { title, description, pubDate, updatedDate, heroImage, chapterNumber, headings } =
	Astro.props;

// 目次。見出しが少ない記事に付けても邪魔なだけなので、5個以上ある時だけ出す。
// h3 まで拾うのは、第5章の「冬 / 夏」のような読み分けを目次から辿れるようにするため。
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length >= 5;

// ブランド名をタイトルに添える（h1 は素のタイトルのまま、<title> だけ補強）
const pageTitle = `${title}｜${SITE_TITLE}`;

// 構造化データは「章」ページ（chapterNumber あり）だけに付ける。
// about / shopping-list など章でないページには付けない（パンくずが不正確になるため）。
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const heroURL = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;
const isChapter = typeof chapterNumber === 'number';
const jsonLd = isChapter
	? [
			{
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				datePublished: pubDate.toISOString(),
				...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
				...(heroURL ? { image: heroURL } : {}),
				inLanguage: 'ja',
				author: { '@type': 'Person', name: SITE_TITLE },
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
				url: canonical,
			},
			{
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{ '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).href },
					{ '@type': 'ListItem', position: 2, name: '記事一覧', item: new URL('/blog/', Astro.site).href },
					{ '@type': 'ListItem', position: 3, name: title, item: canonical },
				],
			},
		]
	: undefined;

const allPosts = await getCollection('blog');
const ordered = allPosts
	.filter((p) => typeof p.data.chapterNumber === 'number')
	.sort((a, b) => (a.data.chapterNumber as number) - (b.data.chapterNumber as number));

let prev: (typeof ordered)[number] | undefined;
let next: (typeof ordered)[number] | undefined;
if (typeof chapterNumber === 'number') {
	prev = [...ordered].reverse().find((p) => (p.data.chapterNumber as number) < chapterNumber);
	next = ordered.find((p) => (p.data.chapterNumber as number) > chapterNumber);
}
---

<html lang="ja">
	<head>
		<BaseHead title={pageTitle} description={description} image={heroImage} jsonLd={jsonLd} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 1.5em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-width: 480px;
				width: calc(100% - 2em);
				height: auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 0.6em;
				padding: 0.4em 0 0.6em;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0.2em 0 0.4em 0;
				font-size: 1.4em;
			}
			.chapter-num {
				color: rgb(var(--gray));
				font-size: 0.95em;
				margin-bottom: 0.4em;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.chapter-nav {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1em;
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.chapter-nav-item {
				display: flex;
				flex-direction: column;
				padding: 0.8em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				transition: border-color 0.15s;
			}
			.chapter-nav-item:hover {
				border-color: var(--accent);
			}
			.chapter-nav-item.next {
				text-align: right;
			}
			.chapter-nav-label {
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin-bottom: 0.2em;
			}
			.chapter-nav-title {
				font-weight: 700;
			}
			.chapter-nav-placeholder {
				/* keeps the grid balanced when prev or next is missing */
			}
			.chapter-nav-toc {
				text-align: center;
				margin-top: 1em;
				font-size: 0.95em;
			}
			.chapter-nav-toc a {
				color: rgb(var(--gray));
			}
			/* 章の目次（見出しが5個以上の記事だけ） */
			.toc {
				margin: 0 0 2.5em;
				padding: 1em 1.4em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: rgba(var(--gray-light), 25%);
			}
			.toc-title {
				margin: 0 0 0.5em;
				font-weight: 700;
				font-size: 0.95em;
				color: rgb(var(--gray-dark));
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				line-height: 1.7;
			}
			.toc li {
				font-size: 0.95em;
			}
			.toc li::before {
				content: '・';
				color: rgb(var(--gray));
			}
			.toc .toc-sub {
				padding-left: 1.2em;
				font-size: 0.9em;
			}
			.toc .toc-sub::before {
				content: '－';
			}
			.toc a {
				color: rgb(var(--gray-dark));
				text-decoration: none;
			}
			.toc a:hover {
				color: var(--accent);
				text-decoration: underline;
			}
			/* 見出しへ飛んだ時に、上に隠れず余白を持って止まる */
			article :global(h2),
			article :global(h3) {
				scroll-margin-top: 1.5em;
			}
			/* 図クリックで拡大表示 */
			article figure img {
				cursor: zoom-in;
			}
			.lightbox {
				display: none;
				position: fixed;
				inset: 0;
				z-index: 9999;
				background: rgba(0, 0, 0, 0.85);
				cursor: zoom-out;
				align-items: center;
				justify-content: center;
				padding: 20px;
			}
			.lightbox.open {
				display: flex;
			}
			.lightbox img {
				max-width: 100%;
				max-height: 100%;
				background: #fff;
				border-radius: 8px;
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="lightbox" id="lightbox">
			<img id="lightbox-img" alt="" />
		</div>
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{
							typeof chapterNumber === 'number' && (
								<div class="chapter-num">第 {chapterNumber} 章</div>
							)
						}
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										最終更新: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					{
						showToc && (
							<nav class="toc" aria-label="この章の目次">
								<p class="toc-title">この章の内容</p>
								<ul>
									{toc.map((h) => (
										<li class={h.depth === 3 ? 'toc-sub' : ''}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</nav>
						)
					}
					<slot />
					{
						(prev || next) && (
							<nav class="chapter-nav">
								{prev ? (
									<a class="chapter-nav-item prev" href={`/blog/${prev.id}/`}>
										<span class="chapter-nav-label">← 前の章 (第 {prev.data.chapterNumber} 章)</span>
										<span class="chapter-nav-title">{prev.data.title}</span>
									</a>
								) : (
									<span class="chapter-nav-placeholder" />
								)}
								{next ? (
									<a class="chapter-nav-item next" href={`/blog/${next.id}/`}>
										<span class="chapter-nav-label">次の章 (第 {next.data.chapterNumber} 章) →</span>
										<span class="chapter-nav-title">{next.data.title}</span>
									</a>
								) : (
									<span class="chapter-nav-placeholder" />
								)}
							</nav>
						)
					}
					<div class="chapter-nav-toc">
						<a href="/blog/">記事一覧へ</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				const lb = document.getElementById('lightbox');
				const lbImg = document.getElementById('lightbox-img');
				if (!lb || !lbImg) return;
				document.querySelectorAll('article figure img').forEach((img) => {
					img.addEventListener('click', () => {
						lbImg.src = img.src;
						lbImg.alt = img.alt || '';
						lb.classList.add('open');
					});
				});
				lb.addEventListener('click', () => lb.classList.remove('open'));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') lb.classList.remove('open');
				});
			})();
		</script>
	</body>
</html>
